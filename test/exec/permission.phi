import std.io

fn held(num: *u8) {
    _ = num
    io.print("held\n")
}

fn main() {
    let b: u8 = 7
    var num: *u8 | none = &b
    let a = num
    if a is *u8 {
        held(a)
    }
    num = none
    let gone = num
    if gone is none {
        io.print("gone\n")
    }

    var c: u8 = 9
    var either: *u8 | *var u8 | none = &b
    if either is *u8 {
        io.print("immutable\n")
    }
    either = &c
    if either is *var u8 {
        io.print("mutable\n")
    }
}
