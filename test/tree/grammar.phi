import std.mem

pub type Alias = i64
type Pointer = *var i64
type Nested = Box[Box[i64]]

pub type Box[T,] = {
    item: T

    fn read(self: *Box[T]) T {
        return self.item
    }

    pub fn write(self: *var Box[T], value: T) {
        self.item = value
    }
}

type Empty = {}

let top_level: i64 = 1 + 2 * 3
pub let exported = 0xff_ff

fn no_return_type(a: i64,) {
    var slot: i64 = a
    slot = a
    slot += a
    slot <<= 1
    defer slot = 0

    _ = slot
}

fn every_expression(p: *var i64, b: Box[i64], flag: bool) i64 {
    let grouped: i64 = (1 + 2) * 3
    let unary = -1 + ~2 + 1
    let boolean = not true
    let address = &grouped
    let read = address.*
    no_return_type(1)
    let literal = Box[i64].{ item: 1 }
    let branched: i64 = if flag { 1 } else { 2 }
    let chained = b
        .read()
    _ = literal
    _ = read
    _ = unary
    _ = boolean
    p.* = grouped
    return branched + chained
}

fn ways_out(limit: i64) i64 {
    if limit > 0 {
        return limit
    }
    return 0
}
