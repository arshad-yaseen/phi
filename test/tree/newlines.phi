fn continuation(a: i64, b: i64) i64 {
    let sum = a +
        b
    let call = wrap(
        a,
        b,
    )
    let compared = a <
        b
    _ = call
    _ = compared
    return sum
}

fn commented(a: i64) i64 {
    let x = a
    let y = a +
        1
    return x + y
}

fn one_liner(a: i64) i64 { return a }

fn packed_block(a: i64) i64 { let b = a; return b }
