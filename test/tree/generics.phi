pub type Box[T] = {
    item: T
}

pub type Pair[K, V] = {
    key: K
    value: V
}

pub type IntBox = Box[i64]
pub type Nested = Box[Box[i64]]

pub fn make[T](store: Store, v: T) *var Box[T] {
    let b = store.make[Box[T]]()
    return b
}

fn use_them(store: Store) {
    _ = make[i64](store, 1)
    _ = store.make[Pair[i64, bool]]()
}
