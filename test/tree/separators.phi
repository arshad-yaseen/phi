type Inline = { x: i64, y: i64 }

type Lines = {
    x: i64
    y: i64
}

type Mixed = {
    x: i64, y: i64,
    z: i64

    fn sum(self: *Mixed) i64 {
        return self.x + self.y + self.z
    }
}

type Pair[
    A
    B
] = {
    first: A,
    second: B,
}

fn spread(
    a: i64
    b: i64,
    c: i64,
) i64 {
    return a + b + c
}

fn call(a: i64) i64 {
    let inline_literal = Inline.{ x: 1, y: 2 }
    let spread_literal = Inline.{
        x: 1
        y: 2
    }
    let trailing = Inline.{
        x: 1,
        y: 2,
    }
    let pair = Pair[
        i64
        i64
    ].{ first: 1, second: 2 }

    _ = inline_literal
    _ = spread_literal
    _ = trailing
    _ = pair
    return spread(
        a
        2,
        3,
    )
}
