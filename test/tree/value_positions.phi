fn returned_if(a: i64, b: i64) i64 {
    return if a > b { a } else { b }
}

fn bound(strict: bool) i64 {
    let limit: i64 = if strict { 10 } else { 100 }
    return limit
}

fn chained(n: i64) i64 {
    let grade: i64 = if n > 90 { 1 } else if n > 50 { 2 } else { 3 }
    return grade
}

fn nested_arm(a: bool, b: bool) i64 {
    let n: i64 = if a { if b { 1 } else { 2 } } else { 3 }
    return n
}

fn arm_with_statements(c: bool) i64 {
    let n: i64 = if c {
        let base = 8000
        base + 80
    } else {
        0
    }
    return n
}

fn ways_out(c: bool) i64 {
    let a = if c { 1 } else { return 0 }
    return a
}

fn as_an_argument(c: bool) i64 {
    return take(if c { 1 } else { 2 })
}

fn take(n: i64) i64 {
    return n
}
