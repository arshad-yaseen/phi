root
  import_decl
    path: field_access text
      lhs: ident std
  struct_decl Node
    field plain
      type: ident i64
    field read_only
      type: pointer_type
        child: ident Node
    field writable
      type: pointer_type var
        child: ident Node
    field qualified
      type: field_access Buffer
        lhs: ident text
    field deep
      type: pointer_type var
        child: field_access Buffer
          lhs: ident mem
  fn_decl signatures
    param a
      type: pointer_type
        child: ident Node
    param b
      type: pointer_type var
        child: ident Node
    param c
      type: ident i64
    ret: pointer_type var
      child: ident Node
    body: block
      return_expr
        value: ident b
  fn_decl returns_nothing
    param a
      type: ident i64
    body: block
