type true
type false
type bool = true | false

fn forms(flag: bool, n: i64) i64 {
    loop {
        break
    }

    loop flag {
        continue
    }

    loop flag {
        n
    } else {
        n
    }

    outer: loop {
        loop flag {
            break :outer
            continue :outer
        }
    }

    let v = loop {
        break 1
    }

    let w = loop flag {
        break :outer v + 1
    } else {
        2
    }

    let x = named: loop {
        break :named w
    }

    return x
}

fn ranges(n: i64, xs: []u32) i64 {
    loop i in 0..n {
        continue
    }

    loop i in 0..xs.len {
        break
    }

    outer: loop row in 0..2 {
        loop column in 0..3 {
            break :outer
        }
    }

    let v: i64 = loop i in 0..n {
        break i
    } else {
        0
    }

    return v
}
