type true
type false
type bool = true | false

type Timeout
type NotFound

fn fetch(flag: bool) u32 | Timeout | NotFound {
    if flag {
        return 1
    }
    return Timeout
}

// every arm returns, so the match satisfies the body on its own
fn all_leave(flag: bool) u32 {
    match flag {
        true => return 1
        false => return 0
    }
}

// a diverging arm contributes no value and no store
fn some_leave(flag: bool) u32 {
    let n: u32 = match flag {
        true => 4
        false => return 0
    }
    return n
}

// 'break' and 'continue' reach the loop around the match
fn drain(flag: bool) u32 {
    var total: u32 = 0
    loop {
        let r = fetch(flag)
        match r {
            u32 => { total += r }
            Timeout => continue
            NotFound => break
        }
    }
    return total
}

// a label reaches out of a nested loop from inside an arm
fn labeled(flag: bool) u32 {
    outer: loop {
        loop {
            match fetch(flag) {
                u32 => break :outer
                Timeout => continue
                NotFound => break
            }
        }
    }
    return 1
}

// a match runs inside a defer on every way out
fn deferred(flag: bool) u32 {
    defer {
        match flag {
            true => {}
            false => {}
        }
    }
    return 1
}

// a match feeds a break value
fn loop_value(flag: bool) u32 {
    return loop {
        break match flag {
            true => 1
            false => 0
        }
    }
}
