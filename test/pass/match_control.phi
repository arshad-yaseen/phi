type true
type false
type bool = true | false

type Timeout
type NotFound

fn fetch(flag: bool) u32 | Timeout | NotFound {
    if flag {
        return 1
    }
    return Timeout
}

fn all_leave(flag: bool) u32 {
    match flag {
        true => return 1
        false => return 0
    }
}

fn some_leave(flag: bool) u32 {
    let n: u32 = match flag {
        true => 4
        false => return 0
    }
    return n
}

fn drain(flag: bool) u32 {
    var total: u32 = 0
    loop {
        let r = fetch(flag)
        match r {
            u32 => { total += r }
            Timeout => continue
            NotFound => break
        }
    }
    return total
}

fn labeled(flag: bool) u32 {
    outer: loop {
        loop {
            match fetch(flag) {
                u32 => break :outer
                Timeout => continue
                NotFound => break
            }
        }
    }
    return 1
}

fn deferred(flag: bool) u32 {
    defer {
        match flag {
            true => {}
            false => {}
        }
    }
    return 1
}

fn loop_value(flag: bool) u32 {
    return loop {
        break match flag {
            true => 1
            false => 0
        }
    }
}
