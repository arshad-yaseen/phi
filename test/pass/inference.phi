type Wide = {
    a: i64
}

fn direct[T](value: T) T {
    return value
}

fn through[T](value: *var T) *var T {
    return value
}

fn drive(wide: Wide) i64 {
    var mine = wide
    let copied = direct(mine)
    let pointer = through(&mine)
    return copied.a + pointer.a
}

fn counted[T](xs: []T) u64 {
    return xs.len
}

fn triple[T](a: [3]T) u64 {
    return a.len
}

fn behind[T](p: *[]T) u64 {
    return p.len
}

fn both_ends[T](a: []T, b: []T) u64 {
    return a.len + b.len
}

fn pinned_by_a_wrapper(xs: []u32, arr: [3]i16, p: *[]u8) u64 {
    return counted(xs) + triple(arr) + behind(p) + both_ends(xs, xs)
}

fn pair[T](a: T, b: T) T {
    return a
}

fn pinned_by_the_second(n: u32) u32 {
    return pair(1, n)
}

/// An unlanded array still knows its elements, so `[]T` reads through a literal.
fn counted_bytes() u64 {
    return counted("hello")
}

fn nested_view[T](rows: [][]T) u64 {
    return rows.len
}

fn deep_literal() u64 {
    return nested_view(["ab", "cd"])
}

/// A union hint pins the member the bound admits and the literal fits.
fn narrow_or_wide[T: Integer](n: T) T {
    return n
}

fn takes_either(value: u64 | i64) u64 {
    _ = value
    return 1
}

fn skips_the_member_it_cannot_fit() u64 {
    return takes_either(narrow_or_wide(-7))
}
