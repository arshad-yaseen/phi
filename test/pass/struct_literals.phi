type Point = {
    x: i64
    y: i64
}

type Frame = {
    origin: Point
    size: Point
    label: u32
}

fn framed(width: i64) Frame {
    return .{
        origin: .{ x: 0, y: 0 },
        size: .{ x: width, y: width * 2 },
        label: 7,
    }
}

fn area_of(frame: Frame) i64 {
    return frame.size.x * frame.size.y
}

fn build() i64 {
    let frame: Frame = framed(3)
    return area_of(frame)
}
