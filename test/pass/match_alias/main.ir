fn source(flag: true | false) u32 | Timeout | NotFound
b0:
  %0 = param flag : true | false
  branch %0, b1, b2
b1:
  return 1:u32
b2:
  jump b3
b3:
  return Timeout

fn settle(flag: true | false) u32
b0:
  %0 = param flag : true | false
  %1 = call source(%0) : u32 | Timeout | NotFound
  %2 = local : *var u32
  %3 = union_is %1, Timeout | NotFound
  branch %3, b2, b3
b1:
  %8 = load %2 : u32
  return %8
b2:
  %4 = union_narrow %1 : Timeout | NotFound
  %5 = store %2, 0:u32
  jump b1
b3:
  jump b4
b4:
  %6 = union_narrow %1 : u32
  %7 = store %2, %6
  jump b1
