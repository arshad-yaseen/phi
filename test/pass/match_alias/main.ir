fn source(flag: true | false) u32 | Timeout | NotFound
b0:
  %0 = param flag : true | false
  branch %0, b1, b2
b1:
  return 1:u32
b2:
  jump b3
b3:
  return Timeout

fn settle(flag: true | false) u32
b0:
  %0 = param flag : true | false
  %1 = call source(%0) : u32 | Timeout | NotFound
  %2 = local : *var u32
  %3 = union_is %1, Timeout
  branch %3, b2, b3
b1:
  %9 = load %2 : u32
  return %9
b2:
  %5 = union_narrow %1 : Timeout | NotFound
  %6 = store %2, 0:u32
  jump b1
b3:
  %4 = union_is %1, NotFound
  branch %4, b2, b4
b4:
  jump b5
