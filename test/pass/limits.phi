fn highest_u8() u8 {
    return @max_int[u8]()
}

fn lowest_i32() i32 {
    return @min_int[i32]()
}

fn lowest_u64() u64 {
    return @min_int[u64]()
}

fn highest_u64() u64 {
    return @max_int[u64]()
}

fn lowest_i64() i64 {
    return @min_int[i64]()
}

fn widened() i64 {
    return @max_int[u32]()
}

fn saturating(n: u32) u32 {
    if n > @max_int[u16]() {
        return @max_int[u16]()
    }
    return n
}

type Byte = u8

fn through_an_alias() u8 {
    return @max_int[Byte]()
}
