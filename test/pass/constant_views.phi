type Config = { primes: []u32 }

fn takes(xs: []u32) u64 {
    return xs.len
}

fn returned() []u32 {
    return [2, 3, 5, 7]
}

fn argument() u64 {
    return takes([2, 3, 5, 7])
}

fn bound() u64 {
    let xs: []u32 = [2, 3, 5, 7]
    return xs.len
}

fn field() Config {
    return .{ primes: [2, 3, 5, 7] }
}

fn optional() []u32 | none {
    return [2, 3, 5, 7]
}

fn indexed() u32 {
    let xs: []u32 = [2, 3, 5, 7]
    return xs[1]
}

fn empty() []u32 {
    return []
}

fn stored() [4]u32 {
    return [2, 3, 5, 7]
}
