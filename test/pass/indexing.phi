type Cell = {
    slot: [2]u32
}

let table: [4]u32 = [2, 3, 5, 7]
let third = table[2]

fn read(a: [4]u32) u32 {
    return a[1]
}

fn write() u32 {
    var a: [4]u32 = [1, 2, 3, 4]
    a[0] = 9
    a[1] += 1
    return a[0]
}

fn address(a: [4]u32) u32 {
    let p = &a[0]
    return p.*
}

fn nested(g: [2][3]u8) u8 {
    return g[1][2]
}

fn nested_write() u8 {
    var g: [2][3]u8 = [[1, 2, 3], [4, 5, 6]]
    g[1][2] = 7
    return g[1][2]
}

fn through_a_pointer(p: *var [4]u32) u32 {
    p[0] = 1
    return p[0]
}

fn a_runtime_index(a: [4]u32, i: u64) u32 {
    return a[i]
}

fn a_signed_index(a: [4]u32, i: i32) u32 {
    return a[i]
}

fn a_runtime_write(i: u64) u32 {
    var a: [4]u32 = [1, 2, 3, 4]
    a[i] = 9
    return a[0]
}

fn never_in_range(a: [0]u64, i: u64) u64 {
    return a[i]
}

fn through_a_field(c: Cell) u32 {
    return c.slot[1]
}

fn into_a_field() u32 {
    var c: Cell = .{ slot: [1, 2] }
    c.slot[0] = 3
    return c.slot[0]
}

fn folded() u32 {
    return third
}
