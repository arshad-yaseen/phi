type List[T] = {
    items: []var T
    capacity: u64
}

type Tree = {
    value: u32
    children: []Tree
}

fn count(xs: []u32) u64 {
    return xs.len
}

fn first(xs: []u32) u32 {
    return xs[0]
}

fn sum(xs: []u32) u32 {
    var total: u32 = 0
    var i: u64 = 0
    loop i < xs.len {
        total += xs[i]
        i += 1
    }
    return total
}

fn fill(xs: []var u32) {
    xs[0] = 1
}

fn through_a_let(xs: []var u32) {
    let same = xs
    same[1] = 2
}

fn widen(xs: []var u32) u32 {
    return sum(xs)
}

fn through_a_pointer(p: *[]u32) u32 {
    return p[0]
}

fn counted_through_a_pointer(p: *[]u32) u64 {
    return p.len
}

fn held(list: List[u32]) u64 {
    return list.items.len + list.capacity
}

fn grown(tree: Tree) u64 {
    return tree.children.len
}

fn into_a_held_view(list: List[u32]) {
    list.items[0] = 7
}

fn counted(found: []u32 | none) u64 {
    if found is []u32 {
        return found.len
    }
    return 0
}

fn matched(found: []u32 | none) u64 {
    return match found {
        []u32 => found.len
        none => 0
    }
}

fn address(xs: []u32) *u32 {
    return xs.ptr
}

fn writable_address(xs: []var u32) *var u32 {
    return xs.ptr
}

fn address_through_a_pointer(p: *[]u32) *u32 {
    return p.ptr
}

fn address_of_storage(a: *[4]u32) *u32 {
    return a[0..].ptr
}
