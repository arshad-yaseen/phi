pub type Box[T] = {
    item: T
}

pub type Number = i64
pub type Boxed = Box[Number]
pub type Same = Boxed

fn fill(value: Number) Same {
    var box = Same.{ item: value }
    box.item = value
    return box
}

fn read(box: *Same) Number {
    return box.item
}

fn drive(value: Number) Number {
    var box = fill(value)
    return read(&box)
}
