type true
type false
type bool = true | false

type Timeout
type NotFound

type LoadError = Timeout | NotFound

fn fetch(flag: bool) u32 | Timeout | NotFound {
    if flag {
        return 1
    }
    return Timeout
}

fn sink(value: u32) u32 {
    return value
}

fn sink_error(e: LoadError) u32 {
    _ = e
    return 9
}

fn note(value: u32) {
    _ = value
}

fn classify(flag: bool) u32 {
    let r = fetch(flag)
    return match r {
        u32 => r
        Timeout => 100
        NotFound => 200
    }
}

fn grouped(flag: bool) u32 {
    let r = fetch(flag)
    return match r {
        u32 => sink(r)
        LoadError => sink_error(r)
    }
}

fn written_group(flag: bool) u32 {
    let r = fetch(flag)
    return match r {
        Timeout | NotFound => sink_error(r)
        u32 => r
    }
}

fn rest_bare(flag: bool) u32 {
    let r = fetch(flag)
    return match r {
        Timeout => 1
        NotFound => 2
        else => r + 1
    }
}

fn rest_union(flag: bool) u32 {
    let r = fetch(flag)
    return match r {
        u32 => r
        else => sink_error(r)
    }
}

fn rest_everything(flag: bool) u32 {
    let r = fetch(flag)
    match r {
        else => {}
    }
    return 0
}

fn statement_form(flag: bool) {
    let r = fetch(flag)
    match r {
        u32 => note(r)
        Timeout => {}
        NotFound => {}
    }
}

fn truthy(flag: bool) u32 {
    return match flag {
        true => 1
        false => 0
    }
}

fn compare(a: u32, b: u32) u32 {
    return match a < b {
        true => 1
        false => 0
    }
}

fn folded() u32 {
    let truth = 1 < 2
    return match truth {
        true => 1
        false => 0
    }
}

fn hinted(flag: bool) u32 {
    let n: u32 = match flag {
        true => 255
        false => 0
    }
    return n
}

fn nested(a: bool, b: bool) u32 {
    return match a {
        true => match b {
            true => 3
            false => 2
        }
        false => 0
    }
}

fn styled(flag: bool) u32 {
    let value = fetch(flag) or e {
        match e {
            Timeout => note(1)
            NotFound => note(2)
        }
        return 0
    }
    return value
}

fn arm_guard(flag: bool) u32 {
    let r = fetch(flag)
    return match r {
        u32 => if r > 10 { 1 } else { 2 }
        else => 0
    }
}
