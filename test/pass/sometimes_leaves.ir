fn sometimes(flag: true | false) u32
b0:
  %0 = param flag : true | false
  %1 = local : *var true | false
  branch %0, b4, b5
b1:
  return 1:u32
b2:
  jump b3
b3:
  return 2:u32
b4:
  return 9:u32
b5:
  %2 = not %0 : true | false
  %3 = store %1, %2
  jump b6
b6:
  %4 = load %1 : true | false
  branch %4, b1, b2

fn in_a_loop(flag: true | false) u32
b0:
  %0 = param flag : true | false
  %1 = local count : *var u32
  %2 = store %1, 0:u32
  jump b1
b1:
  %3 = local : *var true | false
  branch %0, b4, b5
b2:
  %8 = load %1 : u32
  %9 = add %8, 1:u32 : u32
  %10 = store %1, %9
  jump b1
b3:
  %11 = load %1 : u32
  return %11
b4:
  return 9:u32
b5:
  %4 = load %1 : u32
  %5 = cmp_lt %4, 3:u32 : true | false
  %6 = store %3, %5
  jump b6
b6:
  %7 = load %3 : true | false
  branch %7, b2, b3
