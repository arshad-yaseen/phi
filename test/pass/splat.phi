type none

fn zeroed() [4]u8 {
    let buffer: [4]u8 = @splat(0)
    return buffer
}

fn page() [64]u8 {
    return @splat(0xAA)
}

fn grid() [2][3]u32 {
    return @splat(7)
}

fn buffered() u8 {
    var buffer: [4]u8 = @splat(0)
    buffer[1] = 9
    return buffer[1]
}

fn absent() [2]u8 | none {
    return @splat(3)
}

fn written_out() [4]u8 {
    return [0, 0, 0, 0]
}

fn folded() u8 {
    let buffer: [8]u8 = @splat(3)
    return buffer[5]
}

fn repeated() []u8 {
    return "aaa"
}
