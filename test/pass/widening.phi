fn lands(small: u8) u32 {
    return small
}

fn crosses(small: u8) i16 {
    return small
}

fn keeps_the_sign(small: i8) i64 {
    return small
}

fn from_a_constant() u64 {
    let byte: u8 = 200
    return byte
}

type Pair = {
    wide: i64
}

fn into_a_field(small: i32) Pair {
    return .{ wide: small }
}

fn into_an_argument(small: u16) u32 {
    return lands_wide(small)
}

fn lands_wide(n: u32) u32 {
    return n
}

fn into_an_element(small: u8) [2]u32 {
    return [small, 1]
}

fn floats(x: f32) f64 {
    return x
}

fn adds(a: i32, b: i64) i64 {
    return a + b
}

fn shifts(value: u32, by: u8) u32 {
    return value << by
}

fn counted(xs: []u32) u32 {
    var total: u32 = 0
    var at: u32 = 0
    loop at < xs.len {
        total += xs[at]
        at += 1
    }
    return total
}

fn float_operands(a: f32, b: f64) f64 {
    return a + b
}

// an integer reaches a float that holds every value of it exactly
fn to_double(n: u32) f64 {
    return n
}

fn signed_to_double(n: i32) f64 {
    return n
}

fn to_single(n: i16) f32 {
    return n
}

fn mixed_operands(a: u32, b: f64) f64 {
    return a + b
}

fn into_an_optional(n: u16) f32 | none {
    return n
}

// the largest an f32 and an f64 hold whole, and a typed constant that widens
let widest_single: f32 = 16777216
let widest_double: f64 = 9007199254740992
let small_constant: u8 = 200
let small_as_double: f64 = small_constant

fn edges() f64 {
    return widest_single + widest_double + small_as_double
}
