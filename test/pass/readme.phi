import std/io

type BadDigit = {
    at: u64
}

fn parse(text: []u8) u64 | BadDigit {
    var value: u64 = 0
    loop i in 0..text.len {
        let digit = text[i]
        if digit < '0' or digit > '9' {
            return BadDigit.{ at: i }
        }
        value = value * 10 + (digit - '0')
    }
    return value
}

fn check(text: []u8) {
    let value = parse(text) or bad {
        point(text, bad.at)
        return
    }
    if value == 42 {
        io.print("Hello, world!\n")
    }
}

fn point(text: []u8, at: u64) {
    io.print(text)
    io.print("\n")
    var margin: [64]u8 = @repeat(' ')
    margin[at] = '^'
    io.print(margin[0..at + 1])
    io.print("\n")
}

fn main() {
    check("42")
    check("4x2")
}
