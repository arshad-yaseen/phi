type Point = {
    x: u32
    y: u32
}

type Slot = [2]u32 | none

fn hold(f: bool) Slot {
    if f {
        return [1, 2]
    }
    return none
}

fn tested(s: Slot) u32 {
    if s is [2]u32 {
        return 1
    }
    return 0
}

fn matched(s: Slot) u32 {
    return match s {
        [2]u32 => 2
        none => 0
    }
}

fn copies(a: [3]u32) [3]u32 {
    var b: [3]u32 = [0, 0, 0]
    b = a
    return b
}

fn maybe_point(f: bool) Point | none {
    if f {
        return Point.{ x: 1, y: 2 }
    }
    return none
}

fn nested(n: u32) [2]Point {
    return [.{ x: 1, y: 2 }, .{ x: n, y: 4 }]
}

fn receiver() u32 {
    return Point.{ x: 6, y: 7 }.x
}

fn deep(n: u32) [2][2]u32 {
    return [[1, 2], [n, 4]]
}
