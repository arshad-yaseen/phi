type true
type false
type bool = true | false

type Counter = {
    hits: i64

    fn bump(self: *var Counter) {
        self.hits = self.hits + 1
    }
}

fn tidy(early: bool) i64 {
    var counter = Counter.{ hits: 0 }
    defer counter.bump()
    if early {
        return 1
    }
    return 0
}

fn nested_scopes(deep: bool) i64 {
    var counter = Counter.{ hits: 0 }
    defer counter.bump()
    if deep {
        var inner = Counter.{ hits: 0 }
        defer inner.bump()
        return inner.hits
    }
    return counter.hits
}
