fn both_arms_return() u32
b0:
  jump b1
b1:
  return 1:u32

fn the_false_edge() u32
b0:
  jump b1
b1:
  return 2:u32

fn a_live_arm_flows() u32
b0:
  %0 = local total : *var u32
  %1 = store %0, 0:u32
  jump b1
b1:
  %2 = load %0 : u32
  %3 = add %2, 1:u32 : u32
  %4 = store %0, %3
  jump b2
b2:
  %5 = load %0 : u32
  return %5

fn no_else_falls_past() u32
b0:
  jump b1
b1:
  return 1:u32

fn drive(x: f64, n: u32) u32
b0:
  %0 = param x : f64
  %1 = param n : u32
  %2 = call the_dead_arm_is_not_checked[f64](%0) : f64
  %3 = call the_dead_arm_is_not_checked[u32](%1) : u32
  %4 = call on_a_type[f64](%0) : u32
  %5 = call on_a_type[u32](%1) : u32
  %6 = call both_arms_return() : u32
  %7 = call the_false_edge() : u32
  %8 = call a_live_arm_flows() : u32
  %9 = call no_else_falls_past() : u32
  return %9

fn the_dead_arm_is_not_checked[f64](value: f64) f64
b0:
  %0 = param value : f64
  jump b1
b1:
  return %0

fn the_dead_arm_is_not_checked[u32](value: u32) u32
b0:
  %0 = param value : u32
  jump b1
b1:
  %1 = mod %0, 2:u32 : u32
  return %1

fn on_a_type[f64](value: f64) u32
b0:
  %0 = param value : f64
  jump b1
b1:
  return 2:u32

fn on_a_type[u32](value: u32) u32
b0:
  %0 = param value : u32
  jump b1
b1:
  return 1:u32
