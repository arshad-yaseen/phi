type true
type false
type bool = true | false

type none
type Timeout

type Circle = {
    radius: u32

    fn area(self: Circle) u32 {
        return self.radius * self.radius * 3
    }
}

type Rect = {
    width: u32
    height: u32
}

type Line

type Shape = Circle | Rect | Line

fn find(flag: bool) u32 | none {
    if flag {
        return 7
    }
    return none
}

fn fetch(flag: bool) u32 | Timeout | none {
    if flag {
        return 1
    }
    return Timeout
}

// a parameter narrows arm by arm
fn param_narrow(r: u32 | none) u32 {
    return match r {
        u32 => r
        none => 0
    }
}

// fields and methods reach the member an arm proved
fn measure(shape: Shape) u32 {
    return match shape {
        Circle => shape.area()
        Rect => shape.width * shape.height
        Line => 0
    }
}

// `is` narrows a receiver the same way
fn measure_by_is(shape: Shape) u32 {
    if shape is Circle {
        return shape.area()
    }
    return 0
}

// arms that leave narrow what follows the match
fn after(flag: bool) u32 {
    let r = find(flag)
    match r {
        none => return 0
        u32 => {}
    }
    return r + 1
}

// several surviving arms leave their union behind, in declaration order
fn survivors(flag: bool) u32 {
    let r = fetch(flag)
    match r {
        Timeout => return 100
        u32 => {}
        none => {}
    }
    return match r {
        u32 => r
        none => 0
    }
}

// an `is` fact and a match compose, so the match counts the narrowed union
fn composed(r: u32 | Timeout | none) u32 {
    if r is not none {
        return match r {
            u32 => r
            Timeout => 5
        }
    }
    return 0
}
