type none

fn stop() {
    @trap()
}

fn guarded(n: u32) u32 {
    if n == 0 {
        @trap()
    }
    return n
}

fn find(n: u32) u32 | none {
    if n == 0 {
        return none
    }
    return n
}

fn must(n: u32) u32 {
    let found = find(n)
    if found is u32 {
        return found
    }
    @trap()
}

fn must_or(n: u32) u32 {
    return find(n) or e {
        _ = e
        @trap()
    }
}
