type true
type false
type bool = true | false

pub type Pair[K, V] = {
    key: K
    value: V

    pub fn swap_value(self: *var Pair[K, V], value: V) V {
        let old = self.value
        self.value = value
        return old
    }
}

pub type Named = Pair[bool, i64]

fn make() Named {
    let pair = Pair[bool, i64].{ key: true, value: 41 }
    return pair
}

fn use_them() i64 {
    var pair = make()
    let old = pair.swap_value(42)
    return old + pair.value
}
