fn total(n: u32) u64 {
    return @int_cast[u64](n)
}

fn narrows(n: u64) u32 {
    return @int_cast[u32](n)
}

fn signs(n: i32) i64 {
    return @int_cast[i64](n)
}

fn constant() u8 {
    return @int_cast[u8](200)
}

fn from_a_hint(n: u64) u16 {
    let small: u16 = @int_cast(n)
    return small
}
