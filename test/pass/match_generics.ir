fn open(b: Box[u32] | none) u32
b0:
  %0 = param b : Box[u32] | none
  %1 = local : *var u32
  %2 = union_is %0, Box[u32]
  branch %2, b2, b3
b1:
  %8 = load %1 : u32
  return %8
b2:
  %3 = union_narrow %0 : Box[u32]
  %4 = field_val %3, .item : u32
  %5 = store %1, %4
  jump b1
b3:
  jump b4
b4:
  %6 = union_narrow %0 : none
  %7 = store %1, 0:u32
  jump b1

fn drive(v: u32 | none, b: Box[u32] | none) u32
b0:
  %0 = param v : u32 | none
  %1 = param b : Box[u32] | none
  %2 = call unwrap_or[u32](%0, 5:u32) : u32
  %3 = call open(%1) : u32
  %4 = add %2, %3 : u32
  return %4

fn unwrap_or[u32](v: u32 | none, fallback: u32) u32
b0:
  %0 = param v : u32 | none
  %1 = param fallback : u32
  %2 = local : *var u32
  %3 = union_is %0, u32
  branch %3, b2, b3
b1:
  %8 = load %2 : u32
  return %8
b2:
  %4 = union_narrow %0 : u32
  %5 = store %2, %4
  jump b1
b3:
  jump b4
b4:
  %6 = union_narrow %0 : none
  %7 = store %2, %1
  jump b1
