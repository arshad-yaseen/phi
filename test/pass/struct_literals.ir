fn framed(width: i64) Frame
b0:
  %0 = param width : i64
  %1 = mul %0, 2:i64 : i64
  %2 = aggregate_init .{ x: %0, y: %1 } : Point
  %3 = aggregate_init .{ origin: Point.{ x: 0:i64, y: 0:i64 }, size: %2, label: 7:u32 } : Frame
  return %3

fn area_of(frame: Frame) i64
b0:
  %0 = param frame : Frame
  %1 = field_val %0, .size : Point
  %2 = field_val %1, .x : i64
  %3 = field_val %0, .size : Point
  %4 = field_val %3, .y : i64
  %5 = mul %2, %4 : i64
  return %5

fn build() i64
b0:
  %0 = call framed(3:i64) : Frame
  %1 = call area_of(%0) : i64
  return %1
