type true
type false
type bool = true | false

type Plain = {
    a: i64
    b: bool
    label: u32
}

type Cloner = {
    seen: i64

    fn take[T](self: Cloner, value: T) T {
        return value
    }
}

fn duplicate(cloner: Cloner, source: Plain) Plain {
    let explicit = cloner.take[Plain](source)
    let inferred = cloner.take(explicit)
    let number = cloner.take(source.a)
    _ = number
    return inferred
}
