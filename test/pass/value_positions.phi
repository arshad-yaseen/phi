type true
type false
type bool = true | false

type Cell = {
    value: i64
}

fn returned_if(a: i64, b: i64) i64 {
    return if a > b { a } else { b }
}

fn tail_of_a_block(c: bool) i64 {
    let n: i64 = if c {
        let base: i64 = 8000
        base + 80
    } else {
        0
    }
    return n
}

fn one_arm_leaves(c: bool) i64 {
    let n: i64 = if c { 1 } else { return 0 }
    return n
}

fn both_arms_leave(c: bool) i64 {
    if c { return 1 } else { return 2 }
}

fn statement_position(c: bool, out: *var Cell) {
    if c {
        out.value = 1
    } else {
        out.value = 2
    }
}

fn as_an_argument(c: bool) i64 {
    return take(if c { 1 } else { 2 })
}

fn take(n: i64) i64 {
    return n
}

fn every_arm_leaves(a: bool, b: bool) i64 {
    let n: i64 = if a {
        if b { return 1 } else { return 2 }
    } else {
        3
    }
    return n
}

fn leaving_from_an_operand(a: i64, c: bool) i64 {
    let n = take(if c { 1 } else { return 0 }) + 1
    return n + a
}

fn operand_that_never_arrives(a: i64, c: bool) i64 {
    return a + (if c { return 1 } else { return 2 })
}
