type Header = {
    magic: [4]u8
    version: u32
}

fn sealed() [4]u32 {
    let four: [4]u32 = [1, 2, 3, 4]
    return four
}

fn nested() [2][3]u8 {
    let grid: [2][3]u8 = [[1, 2, 3], [4, 5, 6]]
    return grid
}

fn twice() u64 {
    let table = [2, 3, 5, 7]
    let small: [4]u8 = table
    let wide: [4]u64 = table
    return small.len + wide.len
}

fn stored() u64 {
    var slot: [2]u32 = [10, 20]
    return slot.len
}

fn header() Header {
    return .{ magic: [1, 2, 3, 4], version: 1 }
}

fn empty() u64 {
    let nothing: [0]u32 = []
    return nothing.len
}
