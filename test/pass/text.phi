fn kind() []u8 {
    return "text/plain"
}

fn kind_again() []u8 {
    return "text/plain"
}

fn magic() [2]u8 {
    return "hi"
}

fn escaped() [3]u8 {
    return "a\nb"
}

fn crab() []u8 {
    return "\u{1F980}"
}

fn usage() []u8 {
    return
        \\phi build <root.phi>
        \\
        \\  --run   build, then run it
}

fn tiny() [2]u8 {
    return \\hi
}

fn pattern() []u8 {
    return
        \\^\d+\.\d+$
}

fn twice() [3]u8 {
    return "a\nb"
}

fn twice_again() [3]u8 {
    return
        \\a
        \\b
}

fn greet(who: []u8) u64 {
    return who.len
}

fn is_a(s: []u8, at: u64) bool {
    return s[at] == 'a'
}

fn wide() u32 {
    let crab_point: u32 = '🦀'
    return crab_point
}
