fn fetch(bad: true | false) u32 | Timeout | NotFound
b0:
  %0 = param bad : true | false
  branch %0, b1, b2
b1:
  return Timeout
b2:
  jump b3
b3:
  return 1:u32

fn any(bad: true | false) u32
b0:
  %0 = param bad : true | false
  %1 = call fetch(%0) : u32 | Timeout | NotFound
  jump b2
b1:
  return 0:u32
b2:
  jump b1

fn whole(value: u64 | i64) u64 | i64
b0:
  %0 = param value : u64 | i64
  %1 = local : *var u64 | i64
  jump b2
b1:
  %3 = load %1 : u64 | i64
  return %3
b2:
  %2 = store %1, %0
  jump b1
