type Point = {
    x: u32
    y: u32
}

let origin: Point = .{ x: 0, y: 0 }

fn corners() [2]Point {
    return [.{ x: 0, y: 0 }, .{ x: 1, y: 1 }]
}

fn mixed(n: u32) Point {
    return .{ x: 1, y: n }
}

fn runtime_elements(n: u32) [2]u32 {
    let pair: [2]u32 = [1, n]
    return pair
}

fn folded_field() u32 {
    return origin.x
}

fn varies() u32 {
    var here = Point.{ x: 3, y: 4 }
    here.x = 5
    return here.x
}
