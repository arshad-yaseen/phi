type ParseErr
type RangeErr

fn digit(c: u8) u8 | ParseErr | RangeErr {
    if c < '0' {
        return ParseErr
    }
    if c > '9' {
        return RangeErr
    }
    return c - '0'
}

fn add_digits(a: u8, b: u8) u8 | ParseErr | RangeErr {
    let x = digit(a) or return
    let y = digit(b) or return
    return x + y
}

fn main() {
    let sum = add_digits('3', '4') or err {
        _ = err
        @trap()
    }
    if sum != 7 { @trap() }

    let bad = add_digits('!', '4') or err {
        if err is not ParseErr { @trap() }
        return
    }
    _ = bad
    @trap()
}
