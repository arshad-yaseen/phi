type true
type false
type bool = true | false

/// A header that leaves lets nothing through, so what follows cannot be reached.
fn if_cond_leaves() u32 {
    if return 1 { }
    return 2
}

fn loop_cond_leaves() u32 {
    loop return 3 { }
    return 4
}

fn range_start_leaves() u32 {
    loop i in return 5..9 { }
    return 6
}

fn range_end_leaves() u32 {
    loop i in 0..return 7 { }
    return 8
}

fn match_scrutinee_leaves() u32 {
    match return 9 {
        else => {}
    }
    return 10
}

fn if_value_cond_leaves() u32 {
    let n: u32 = if return 11 { 12 } else { 13 }
    return n
}
