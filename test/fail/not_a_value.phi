import std/mem

type Box[T] = {
    item: T

    fn get(self: Box[T]) T {
        return self.item
    }
}

fn helper() i64 {
    return 1
}

fn function_as_value() {
    let f = helper
}

fn function_has_no_fields() {
    let n = helper.field
}

