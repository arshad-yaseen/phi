fn fill(xs: []var u32) {
    xs[0] = 1
}

fn count(xs: []u32) u64 {
    return xs.len
}

fn narrow(xs: []u32) {
    fill(xs)
}

fn write(xs: []u32) {
    xs[0] = 1
}

fn wrong_element(xs: []var u8) {
    fill(xs)
}

fn no_bridge(a: [4]u32) u64 {
    return count(a)
}

fn no_such_member(xs: []u32) u32 {
    return xs.first
}

fn nearly_the_length(xs: []u32) u64 {
    return xs.ln
}

fn assign_a_length(xs: []var u32) {
    xs.len = 3
}

fn runtime_part(n: u32) []u32 {
    return [n, 3, 5, 7]
}

fn writable() []var u32 {
    return [2, 3]
}

fn sealed() []u32 {
    let a: [4]u32 = [2, 3, 5, 7]
    return a
}

fn assign_an_address(xs: []var u32) {
    xs.ptr = xs.ptr
}

fn address_of_an_array(a: [4]u32) *u32 {
    return a.ptr
}
