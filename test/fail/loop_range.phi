fn backwards() {
    loop i in 5..3 {
        _ = i
    }
}

fn crossed_types(n: u32) {
    var from: u64 = 0
    loop i in from..n {
        _ = i
    }
}

fn not_a_count(flag: bool) {
    loop i in 0..flag {
        _ = i
    }
}

fn discarded(n: u64) {
    loop _ in 0..n {
    }
}

fn assigned(n: u64) {
    loop i in 0..n {
        i = 3
    }
}
