type Point = {
    x: u32
}

let table: [4]u32 = [2, 3, 5, 7]

fn past_the_end(a: [4]u32) u32 {
    return a[4]
}

fn before_the_start(a: [4]u32) u32 {
    return a[-1]
}

fn a_folded_element() u32 {
    return table[9]
}

fn a_struct(p: Point) u32 {
    return p[0]
}

fn a_constant_that_has_not_landed() u32 {
    let loose = [1, 2, 3]
    return loose[0]
}

fn not_a_count(a: [4]u32) u32 {
    return a[1.5]
}

fn a_let_array() {
    let a: [4]u32 = [1, 2, 3, 4]
    a[0] = 9
}

fn a_parameter(a: [4]u32) {
    a[0] = 9
}

fn a_read_only_pointer(p: *[4]u32) {
    p[0] = 9
}

fn two_at_once(g: [2][3]u8) u8 {
    return g[1, 2]
}

fn its_count_has_not_landed() u64 {
    let loose = [1, 2, 3]
    return loose.len
}
