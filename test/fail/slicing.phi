type Point = {
    x: u32
}

fn count(xs: []u32) u64 {
    return xs.len
}

fn a_struct(p: Point) {
    _ = p[0..]
}

fn not_a_count(a: [4]u32) {
    _ = a[0..1.5]
}

fn ends_disagree(a: [8]u32, i: u32, n: u64) {
    _ = a[i..n]
}

fn no_bridge(a: [4]u32) u64 {
    return count(a)
}

fn not_a_place(a: [4]u32) {
    a[0..2] = a
}

fn ends_cross(a: [4]u32) {
    _ = a[3..1]
}

fn past_the_end(a: [4]u32) {
    _ = a[0..9]
}

fn below_zero(a: [8]u32, i: i32) {
    _ = a[i..-1]
}

let global: [4]u32 = [1, 2, 3, 4]
let sliced = global[0..]
