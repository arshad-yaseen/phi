type Point = {
    x: u32
    y: u32
}

type Other = {
    x: u32
}

// nothing lands it, so nothing says which struct
fn no_hint() u32 {
    let p = .{ x: 1, y: 2 }
    return p.x
}

// a statement asks for nothing at all
fn a_statement() {
    .{ x: 1, y: 2 }
}

fn discarded() {
    _ = .{ x: 1, y: 2 }
}

// a union lists several, and two of them could take these fields
fn a_union_hint(f: bool) Point | Other {
    return .{ x: 1, y: 2 }
}

// one member is a struct, and naming it is still the rule
fn an_optional_hint() Point | none {
    return .{ x: 1, y: 2 }
}

// what it lands on has no fields to give
fn not_a_struct() u32 {
    let n: u32 = .{ x: 1 }
    return n
}

// the written name still has to agree with where it lands
fn the_wrong_struct() Point {
    return Other.{ x: 1 }
}
