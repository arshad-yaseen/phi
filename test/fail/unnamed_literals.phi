type Point = {
    x: u32
    y: u32
}

type Other = {
    x: u32
}

fn no_hint() u32 {
    let p = .{ x: 1, y: 2 }
    return p.x
}

fn a_statement() {
    .{ x: 1, y: 2 }
}

fn discarded() {
    _ = .{ x: 1, y: 2 }
}

fn a_union_hint(f: bool) Point | Other {
    return .{ x: 1, y: 2 }
}

fn an_optional_hint() Point | none {
    return .{ x: 1, y: 2 }
}

fn not_a_struct() u32 {
    let n: u32 = .{ x: 1 }
    return n
}

fn the_wrong_struct() Point {
    return Other.{ x: 1 }
}
