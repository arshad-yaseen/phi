fn no_type() {
    _ = @repeat(0)
}

fn not_an_array() u32 {
    return @repeat(0)
}

fn does_not_fit() [2]u8 {
    return @repeat(300)
}

fn runtime_value(n: u8) [2]u8 {
    return @repeat(n)
}

fn wrong_arity() [2]u8 {
    return @repeat(1, 2)
}

fn written_type() [2]u8 {
    return @repeat[u8](0)
}
