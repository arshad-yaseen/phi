type Point = {
    x: i64
}

fn not_an_integer() u64 {
    return @max_int[f32]()
}

fn not_a_number() u64 {
    return @min_int[Point]()
}

// the edge is exact, so one that does not fit where it lands is refused
fn does_not_fit() i64 {
    return @max_int[u64]()
}

fn below_the_floor() u32 {
    return @min_int[i8]()
}
