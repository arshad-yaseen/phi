fn Counter.bump(self: *var Counter)
b0:
  %0 = param self : *var Counter
  %1 = field_ptr %0, .hits : *var i64
  %2 = field_ptr %0, .hits : *var i64
  %3 = load %2 : i64
  %4 = add %3, 1:i64 : i64
  %5 = store %1, %4
  return

fn tidy(early: true | false) i64
b0:
  %0 = param early : true | false
  %1 = local counter : *var Counter
