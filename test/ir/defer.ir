fn nested_scopes(deep: true | false) i64
b0:
  %0 = param deep : true | false
  %1 = local counter : *var Counter
  %2 = store %1, Counter.{ hits: 0:i64 }
  branch %0, b1, b2
b1:
  %3 = local inner : *var Counter
