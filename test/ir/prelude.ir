fn flag(n: u32) true | false
b0:
  %0 = param n : u32
  %1 = cmp_gt %0, 0:u32 : true | false
  return %1

fn pick(n: u32) u32 | none
b0:
  %0 = param n : u32
  %1 = call flag(%0) : true | false
  branch %1, b1, b2
b1:
  %2 = union_init %0, u32 : u32 | none
  return %2
b2:
  jump b3
b3:
  return none

fn drive(n: u32) u32
b0:
  %0 = param n : u32
  %1 = call pick(%0) : u32 | none
  %2 = local : *var u32 | none
  %3 = store %2, %1
  branch %1, b2, b1
b1:
  %4 = union_init 0:u32, u32 : u32 | none
  %5 = store %2, %4
  jump b2
b2:
  %6 = load %2 : u32 | none
  %7 = union_narrow %6 : u32
  return %7
