fn reinterpret(header: *var Header) *var Payload
b0:
  %0 = param header : *var Header
  %1 = ptr_cast %0 : *var Payload
  return %1

fn keeps_read_only(header: *Header) *Payload
b0:
  %0 = param header : *Header
  %1 = ptr_cast %0 : *Payload
  return %1

fn through_a_field(header: *var Header) i64
b0:
  %0 = param header : *var Header
  %1 = ptr_cast %0 : *var Payload
  %2 = field_ptr %1, .value : *var i64
  %3 = store %2, 1:i64
  %4 = field_ptr %1, .extra : *var i64
  %5 = load %4 : i64
