type Header = {
    tag: i64
}

type Payload = {
    value: i64
    extra: i64
}

fn reinterpret(header: *var Header) *var Payload {
    return @ptr_cast[Payload](header)
}

fn keeps_read_only(header: *Header) *Payload {
    return @ptr_cast[Payload](header)
}

fn through_a_field(header: *var Header) i64 {
    let payload = @ptr_cast[Payload](header)
    payload.value = 1
    return payload.extra
}
