type Point = {
    x: i32
    y: i32
}

type Timeout

extern fn takes_a_view(xs: []u8)

extern fn takes_a_struct(p: Point)
extern fn returns_a_struct() Point

extern fn takes_a_union(reply: u32 | Timeout)

extern fn takes_an_array(a: [4]u8)

extern fn takes_a_bool(flag: bool)

extern fn generic[T](value: T)

extern fn takes_an_absent_view(xs: []u8 | none)
