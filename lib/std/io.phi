import std/c
import std/debug

let stdout: c.int = 1

/// The most bytes `format` writes.
pub let format_max: u64 = 21

let digits: []u8 = "0123456789"

/// https://pubs.opengroup.org/onlinepubs/9699919799/functions/write.html
extern fn write(fd: c.int, buf: *u8, len: c.size_t) c.ssize_t

/// Text, or a number as decimal digits, written to standard output.
pub fn print(value: []u8 | u64 | i64) {
    var buf: [format_max]u8 = @repeat(0)
    write_all(match value {
        []u8 => value
        u64 => format_unsigned(buf[0..], value)
        i64 => format_signed(buf[0..], value)
    })
}

fn format_unsigned(buf: []var u8, value: u64) []u8 {
    var rest = value
    var at = buf.len
    loop {
        at -= 1
        buf[at] = digits[rest % 10]
        rest /= 10
        if rest == 0 {
            break
        }
    }
    return buf[at..]
}

fn format_signed(buf: []var u8, value: i64) []u8 {
    // on the negative side, which every value has and the lowest value only has
    var rest = if value < 0 { value } else { 0 - value }
    var at = buf.len
    loop {
        at -= 1
        buf[at] = digits[0 - rest % 10]
        rest /= 10
        if rest == 0 {
            break
        }
    }
    if value < 0 {
        at -= 1
        buf[at] = '-'
    }
    return buf[at..]
}

fn write_all(bytes: []u8) {
    var rest = bytes
    loop rest.len > 0 {
        let asked = @int_cast[c.size_t](rest.len) or @max_int[c.size_t]()
        // a write that failed answers below zero, which no count of bytes reaches
        let wrote = @int_cast[u64](write(stdout, rest.ptr, asked)) or return
        if wrote == 0 {
            return
        }
        rest = rest[wrote..]
    }
}
