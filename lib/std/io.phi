import std/fmt
import std/sys

/// Text, or a number as decimal digits, written to standard output.
pub fn print(value: []u8 | u64 | i64) {
    var buf: [fmt.decimal_max]u8 = @repeat(0)
    write_all(sys.stdout, match value {
        []u8 => value
        u64 => fmt.decimal(buf[0..], value)
        i64 => fmt.decimal(buf[0..], value)
    })
}

fn write_all(fd: sys.Fd, bytes: []u8) {
    var rest = bytes
    loop rest.len > 0 {
        let wrote = sys.write(fd, rest) or return
        if wrote == 0 {
            return
        }
        rest = rest[wrote..]
    }
}
