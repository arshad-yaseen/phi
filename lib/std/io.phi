import std.debug

extern fn write(fd: i32, buf: *u8, len: u64) i64

/// Write text to standard output.
pub fn print(text: str) {
    var rest = text
    loop {
        if rest.len == 0 {
            return
        }
        let wrote = write(1, rest.ptr, rest.len)
        if wrote <= 0 {
            return
        }
        let count = @int_cast[u64](wrote) or return
        rest = rest[count..]
    }
}

pub let uint_digits_max: u64 = 20

pub fn format_uint(buf: []var u8, value: u64) []u8 {
    debug.assert(buf.len >= uint_digits_max)

    var i = buf.len
    var n = value

    loop {
        let digit = @int_cast[u8](n % 10) or return buf[i..]
        i -= 1
        buf[i] = '0' + digit
        n /= 10
        if n == 0 {
            break
        }
    }

    return buf[i..]
}

/// Write an unsigned integer to standard output, as decimal digits.
pub fn print_uint(value: u64) {
    var buf: [uint_digits_max]u8 = @splat(0)
    print(format_uint(buf[0..], value))
}
