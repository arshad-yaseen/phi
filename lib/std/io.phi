extern fn write(fd: i32, buf: *u8, len: u64) i64

/// Write text to standard output.
pub fn print(text: str) {
    var rest = text
    loop {
        if rest.len == 0 {
            return
        }
        let wrote = write(1, rest.ptr, rest.len)
        if wrote <= 0 {
            return
        }
        let count = @int_cast[u64](wrote) or return
        rest = rest[count..]
    }
}

/// Write an unsigned integer to standard output, as decimal digits.
pub fn print_uint(value: u64) {
    var buf: [20]u8 = @splat(0)

    var i: u64 = 20
    var n = value

    loop {
        i -= 1
        buf[i] = '0' + (@int_cast[u8](n % 10) or return)
        n /= 10
        if n == 0 {
            break
        }
    }

    print(buf[i..])
}
