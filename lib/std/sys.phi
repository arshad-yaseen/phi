import std/sys/c
import std/sys/posix
import std/sys/windows
import std/target

pub type Fd = c.int

pub let stdout: Fd = 1

pub let stderr: Fd = 2

/// How many of `bytes` the file took. None if the write failed.
pub fn write(fd: Fd, bytes: []u8) u64 | none {
    return match target.os {
        target.windows => windows.write(fd, bytes)
        else => posix.write(fd, bytes)
    }
}

/// The bytes in one page, which what the operating system hands out is a
/// multiple of.
pub fn page_size() u64 {
    return match target.os {
        target.windows => windows.page_size()
        else => posix.page_size()
    }
}

/// `bytes` of pages to read and write, straight from the operating system and
/// backed by nothing on disk. None where it would not give them.
pub fn alloc_pages(bytes: u64) []var u8 | none {
    return match target.os {
        target.windows => windows.virtual_alloc(bytes)
        else => posix.mmap_anonymous(bytes)
    }
}

/// Hands back pages that came whole from `alloc_pages`. Anything else stops the
/// program.
pub fn free_pages(pages: []var u8) {
    match target.os {
        target.windows => windows.virtual_free(pages)
        else => posix.munmap(pages)
    }
}
