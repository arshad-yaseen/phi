/// The operating system. The compiler picks the member its build targets.
pub type linux
pub type macos
pub type windows
pub type wasi
pub type Os = linux | macos | windows | wasi

/// The instruction set, named the same way.
pub type x86_64
pub type aarch64
pub type wasm32
pub type Arch = x86_64 | aarch64 | wasm32

pub let os: Os = @target_os()

pub let arch: Arch = @target_arch()

/// How wide an address is, which the compiler answers by laying one out.
pub let pointer_bits: u64 = @size_of[*u8]() * 8
