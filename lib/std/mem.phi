import std/debug
import std/math

/// `addr` rounded up to a multiple of `alignment`, which must be a power of two.
pub fn align_up[T: Unsigned](addr: T, alignment: T) T {
    debug.assert(math.is_power_of_two(alignment))
    return (addr + alignment - 1) & ~(alignment - 1)
}

/// Whether two views hold the same elements in the same order.
pub fn eql[T](a: []T, b: []T) bool {
    if a.len != b.len {
        return false
    }
    loop i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}
