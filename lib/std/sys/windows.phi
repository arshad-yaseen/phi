import std/math
import std/sys/c

/// https://learn.microsoft.com/en-us/cpp/c-runtime-library/reference/write
extern fn _write(fd: c.int, buf: *u8, len: c.uint) c.int

pub fn page_size() u64 {
    @compile_error("std has no pages on windows yet")
}

pub fn virtual_alloc(bytes: u64) []var u8 | none {
    _ = bytes
    @compile_error("std has no pages on windows yet")
}

pub fn virtual_free(pages: []var u8) {
    _ = pages
    @compile_error("std has no pages on windows yet")
}

pub fn write(fd: c.int, bytes: []u8) u64 | none {
    let asked = @int_cast[c.uint](math.min(bytes.len, c.write_count_max))
    return @int_fits[u64](_write(fd, bytes.ptr, asked)) or return none
}
