//! https://en.cppreference.com/w/c/language/arithmetic_types

import std/target

/// Signedness is implementation-defined, and AAPCS64 chooses unsigned.
/// https://github.com/ARM-software/abi-aa/blob/main/aapcs64/aapcs64.rst
pub type char = match target.os {
    target.linux => match target.arch {
        target.aarch64 => u8
        target.x86_64 => i8
    }
    else => i8
}

pub type uchar = u8

pub type short = i16
pub type ushort = u16

pub type int = i32
pub type uint = u32

/// 32 bits under LLP64, an address under LP64 and ILP32.
/// https://learn.microsoft.com/en-us/windows/win32/winprog64/abstract-data-models
pub type long = match target.os {
    target.windows => i32
    else => intptr_t
}

pub type ulong = match target.os {
    target.windows => u32
    else => uintptr_t
}

pub type longlong = i64
pub type ulonglong = u64

/// Wide enough to hold any address. ISO C23 draft N3220 7.22.1.4.
pub type uintptr_t = match target.arch {
    target.x86_64 => u64
    target.aarch64 => u64
    target.wasm32 => u32
}

pub type intptr_t = match target.arch {
    target.x86_64 => i64
    target.aarch64 => i64
    target.wasm32 => i32
}

pub type size_t = uintptr_t

/// POSIX, not ISO C.
/// https://pubs.opengroup.org/onlinepubs/9699919799/basedefs/sys_types.h.html
pub type ssize_t = intptr_t

pub type ptrdiff_t = intptr_t

pub type off_t = match target.os {
    target.windows => long   // MSVC CRT _off_t is 32-bit, _off64_t is the wide one
    else => i64
}

pub let PROT_READ: int = 0x01
pub let PROT_WRITE: int = 0x02

pub let MAP_PRIVATE: int = 0x02

pub let MAP_ANONYMOUS: int = match target.os {
    target.macos => 0x1000
    else => 0x20
}

pub let _SC_PAGESIZE: int = match target.os {
    target.macos => 29
    else => 30
}

/// What `mmap` answers instead of nothing where it refuses.
pub let MAP_FAILED: size_t = @max_int[size_t]()

/// What one write takes at most, past which Linux hands back a prefix and the
/// others refuse.
pub let write_count_max: u64 = match target.os {
    target.linux => 0x7ffff000
    else => 0x7fffffff
}

/// https://pubs.opengroup.org/onlinepubs/9699919799/functions/write.html
pub extern fn write(fd: int, buf: *u8, len: size_t) ssize_t

/// https://pubs.opengroup.org/onlinepubs/9699919799/functions/sysconf.html
pub extern fn sysconf(name: int) long

/// https://pubs.opengroup.org/onlinepubs/9699919799/functions/mmap.html
pub extern fn mmap(
    addr: *u8 | none,
    len: size_t,
    prot: int,
    flags: int,
    fd: int,
    offset: off_t,
) *var u8 | none

/// https://pubs.opengroup.org/onlinepubs/9699919799/functions/munmap.html
pub extern fn munmap(addr: *u8 | none, len: size_t) int
