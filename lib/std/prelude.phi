//! What every file sees. A file's own declaration wins.

/// The absent member of an optional, `T | none`.
pub type none

pub type true
pub type false

/// What a condition asks and a comparison answers.
pub type bool = true | false

/// Text, which is a view of bytes.
pub type str = []u8

pub type Signed = i64 | i32 | i16 | i8

pub type Unsigned = u64 | u32 | u16 | u8

pub type Integer = Signed | Unsigned

pub type Float = f64 | f32

pub type Number = Integer | Float
