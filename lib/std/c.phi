import std/target

pub type char = match target.os {
    target.linux => match target.arch {
        target.aarch64 => u8
        target.x86_64 => i8
    }
    else => i8
}

pub type uchar = u8

pub type short = i16
pub type ushort = u16

pub type int = i32
pub type uint = u32

pub type long = match target.os {
    target.windows => i32
    else => intptr_t
}

pub type ulong = match target.os {
    target.windows => u32
    else => uintptr_t
}

pub type longlong = i64
pub type ulonglong = u64

pub type uintptr_t = match target.arch {
    target.x86_64 => u64
    target.aarch64 => u64
    target.wasm32 => u32
}

pub type intptr_t = match target.arch {
    target.x86_64 => i64
    target.aarch64 => i64
    target.wasm32 => i32
}

pub type size_t = uintptr_t
pub type ssize_t = intptr_t
pub type ptrdiff_t = intptr_t
